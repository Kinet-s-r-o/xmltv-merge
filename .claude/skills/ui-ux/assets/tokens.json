  "dataVisualization": {
    "status": "confirmed",
    "description": "Chart theming is token-driven via lib/chartTheme.ts (useChartTheme hook). Structural colors (text, labels, axes, grid, track, tooltip) read semantic tokens from the document root and update on resolved-theme changes. Series and gauge-zone colors are intentionally hardcoded (user-configurable per metric).",
    "themeHook": {
      "value": "lib/chartTheme.ts — useChartTheme()",
      "description": "Returns a function that reads root tokens via getComputedStyle and maps them to ECharts option colors. Call it inside the reactive option builder so mounted charts re-theme when the resolved theme changes. lib/theme.ts applies the DOM palette before notifying reactive consumers."
    },
    "structuralColors": {
      "text": { "token": "--text-primary", "description": "Tooltip text, gauge detail/split lines" },
      "label": { "token": "--text-muted", "description": "Axis labels, legend, gauge axis labels/ticks, chart titles" },
      "border": { "token": "--border-default", "description": "Axis lines, tooltip border" },
      "grid": { "token": "--border-subtle", "description": "Grid lines" },
      "track": { "token": "--bg-elevated", "description": "Gauge track (progress/ring/multi styles)" },
      "surface": { "token": "--bg-surface", "description": "Tooltip background, gauge speed-style detail background" },
      "accent": { "token": "--accent", "description": "Default line/series color" },
      "success": { "token": "--success", "description": "Online/healthy series" },
