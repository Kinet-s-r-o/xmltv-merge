# Copy to .env and override as needed
# All values have defaults in docker-compose.yml
# DATABASE_URL is derived from POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB

POSTGRES_DB=xmltv
POSTGRES_USER=xmltv
POSTGRES_PASSWORD=xmltv_secret
BACKEND_PORT=8080

# Multicast EIT streaming (only used with docker-compose.multicast.yml)
# MULTICAST_PARENT_IF=eth1
# MULTICAST_SUBNET=192.0.2.0/24
# MULTICAST_GATEWAY=192.0.2.1
# MULTICAST_IPV4=192.0.2.10
# Outgoing interface inside the backend container (name or IPv4 address).
# Defaults to MULTICAST_IPV4, i.e. the macvlan interface.
# MULTICAST_INTERFACE=

# Authentication (see docs/authentication.md)
# Encrypts RADIUS shared secrets and TOTP seeds at rest; use a long random value
# and keep it stable (changing it makes stored secrets unreadable).
# AUTH_SECRET_KEY=
# Create the first administrator at startup when no user exists
# (otherwise the web UI shows a one-time setup page).
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# Session cookie Secure flag: auto (HTTPS detection), true or false.
# AUTH_COOKIE_SECURE=auto
# AUTH_SESSION_IDLE_MINUTES=480
# AUTH_SESSION_MAX_HOURS=168
# AUTH_LOCKOUT_THRESHOLD=5
# AUTH_LOCKOUT_MINUTES=15
